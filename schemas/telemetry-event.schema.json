{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planifest.dev/schemas/telemetry-event/1.0",
  "title": "TelemetryEvent",
  "description": "Common envelope for all Planifest structured telemetry events.",
  "type": "object",
  "required": [
    "schema_version",
    "event",
    "session_id",
    "phase",
    "agent",
    "tool",
    "model",
    "mcp_mode",
    "timestamp"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version. Used to handle schema evolution without breaking stored queries."
    },
    "event": {
      "type": "string",
      "enum": [
        "phase_start",
        "phase_end",
        "spec_gap",
        "validation_failure",
        "deviation",
        "migration_proposal",
        "context_pressure",
        "mcp_impact",
        "self_correction",
        "phase_skip",
        "security_finding",
        "retry_limit_exceeded",
        "adr_decision",
        "doc_gap"
      ],
      "description": "Event type discriminator."
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "UUID identifying the agent session."
    },
    "initiative_id": {
      "type": "string",
      "description": "Feature/initiative identifier from plan/current/. Optional."
    },
    "phase": {
      "type": "string",
      "enum": [
        "orchestrator",
        "spec",
        "adr",
        "codegen",
        "validate",
        "security",
        "docs",
        "change"
      ],
      "description": "Pipeline phase in which the event was emitted."
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "description": "Skill name of the emitting agent (e.g. planifest-codegen-agent)."
    },
    "tool": {
      "type": "string",
      "minLength": 1,
      "description": "Agentic tool name (e.g. claude-code, cursor)."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model identifier (e.g. claude-sonnet-4-6)."
    },
    "mcp_mode": {
      "type": "string",
      "enum": ["none", "workspace", "context", "workspace+context"],
      "description": "Active MCP server configuration during this session."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the event."
    },
    "model_config": {
      "type": "object",
      "description": "Tool-specific model configuration attributes (e.g. effort, thinking). Keys and values are tool-defined.",
      "additionalProperties": true
    },
    "data": {
      "description": "Typed payload. Structure determined by the event field.",
      "oneOf": [
        { "$ref": "#/$defs/PhaseStartData" },
        { "$ref": "#/$defs/PhaseEndData" },
        { "$ref": "#/$defs/SpecGapData" },
        { "$ref": "#/$defs/ValidationFailureData" },
        { "$ref": "#/$defs/DeviationData" },
        { "$ref": "#/$defs/MigrationProposalData" },
        { "$ref": "#/$defs/ContextPressureData" },
        { "$ref": "#/$defs/McpImpactData" },
        { "$ref": "#/$defs/SelfCorrectionData" },
        { "$ref": "#/$defs/PhaseSkipData" },
        { "$ref": "#/$defs/SecurityFindingData" },
        { "$ref": "#/$defs/RetryLimitExceededData" },
        { "$ref": "#/$defs/AdrDecisionData" },
        { "$ref": "#/$defs/DocGapData" }
      ]
    }
  },
  "$defs": {
    "PhaseStartData": {
      "type": "object",
      "required": ["phase_name"],
      "additionalProperties": false,
      "properties": {
        "phase_name": { "type": "string", "minLength": 1 }
      }
    },
    "PhaseEndData": {
      "type": "object",
      "required": ["phase_name", "status", "duration_ms"],
      "additionalProperties": false,
      "properties": {
        "phase_name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "duration_ms": { "type": "number", "minimum": 0 },
        "content_type": { "type": "string" }
      }
    },
    "SpecGapData": {
      "type": "object",
      "required": ["question", "phase_name"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "phase_name": { "type": "string", "minLength": 1 }
      }
    },
    "ValidationFailureData": {
      "type": "object",
      "required": ["failure_type", "phase_name", "attempt_number", "action_id"],
      "additionalProperties": false,
      "properties": {
        "failure_type": { "type": "string", "minLength": 1 },
        "phase_name": { "type": "string", "minLength": 1 },
        "attempt_number": { "type": "integer", "minimum": 1 },
        "action_id": { "type": "string", "minLength": 1 }
      }
    },
    "DeviationData": {
      "type": "object",
      "required": ["component_id", "description", "severity"],
      "additionalProperties": false,
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    },
    "MigrationProposalData": {
      "type": "object",
      "required": ["component_id", "proposal_path", "destructive"],
      "additionalProperties": false,
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "proposal_path": { "type": "string", "minLength": 1 },
        "destructive": { "type": "boolean" }
      }
    },
    "ContextPressureData": {
      "type": "object",
      "required": ["context_fill_pct", "unused_sources", "trigger"],
      "additionalProperties": false,
      "properties": {
        "context_fill_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "unused_sources": { "type": "array", "items": { "type": "string" } },
        "trigger": { "type": "string", "minLength": 1 }
      }
    },
    "McpImpactData": {
      "type": "object",
      "required": ["mcp_mode", "avg_token_delta", "peak_fill_pct"],
      "additionalProperties": false,
      "properties": {
        "mcp_mode": { "type": "string", "enum": ["none", "workspace", "context", "workspace+context"] },
        "avg_token_delta": { "type": "number" },
        "peak_fill_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "SelfCorrectionData": {
      "type": "object",
      "required": ["phase_name", "attempt_number", "action_id", "correction_type"],
      "additionalProperties": false,
      "properties": {
        "phase_name": { "type": "string", "minLength": 1 },
        "attempt_number": { "type": "integer", "minimum": 1 },
        "action_id": { "type": "string", "minLength": 1 },
        "correction_type": { "type": "string", "minLength": 1 }
      }
    },
    "PhaseSkipData": {
      "type": "object",
      "required": ["phase_name", "reason"],
      "additionalProperties": false,
      "properties": {
        "phase_name": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "SecurityFindingData": {
      "type": "object",
      "required": ["component_id", "title", "severity"],
      "additionalProperties": false,
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "cwe": { "type": "string" }
      }
    },
    "RetryLimitExceededData": {
      "type": "object",
      "required": ["phase_name", "action_id", "attempt_count"],
      "additionalProperties": false,
      "properties": {
        "phase_name": { "type": "string", "minLength": 1 },
        "action_id": { "type": "string", "minLength": 1 },
        "attempt_count": { "type": "integer", "minimum": 1 }
      }
    },
    "AdrDecisionData": {
      "type": "object",
      "required": ["adr_id", "title", "chosen_option"],
      "additionalProperties": false,
      "properties": {
        "adr_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "chosen_option": { "type": "string", "minLength": 1 }
      }
    },
    "DocGapData": {
      "type": "object",
      "required": ["component_id", "description"],
      "additionalProperties": false,
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
