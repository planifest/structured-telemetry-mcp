{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planifest.dev/schemas/telemetry-event/1.0",
  "title": "TelemetryEvent",
  "description": "Common envelope for all Planifest structured telemetry events.",
  "type": "object",
  "required": [
    "schema_version",
    "event",
    "session_id",
    "phase",
    "agent",
    "tool",
    "model",
    "mcp_mode",
    "timestamp"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version. Used to handle schema evolution without breaking stored queries."
    },
    "event": {
      "type": "string",
      "enum": [
        "phase_start",
        "phase_end",
        "spec_gap",
        "validation_failure",
        "deviation",
        "migration_proposal",
        "context_pressure",
        "mcp_impact",
        "self_correction",
        "phase_skip",
        "security_finding",
        "retry_limit_exceeded",
        "adr_decision",
        "doc_gap",
        "context_reset",
        "approval_requested",
        "fast_path_engaged",
        "test_failure",
        "performance_regression",
        "dependency_blocked",
        "schema_migration_applied",
        "loop_iteration",
        "phase_reversal_petitioned",
        "phase_reversal_granted",
        "phase_reversal_denied"
      ],
      "description": "Event type discriminator."
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "UUID identifying the agent session."
    },
    "initiative_id": {
      "type": "string",
      "description": "Feature/initiative identifier from plan/current/. Optional."
    },
    "product_id": {
      "type": "string",
      "description": "Identifies the emitting repo/project — the git repo root path (git rev-parse --show-toplevel), falling back to the raw cwd if not inside a git repo. Optional; NULL/absent displays as \"unknown\"."
    },
    "phase": {
      "type": "string",
      "enum": [
        "orchestrator",
        "spec",
        "adr",
        "codegen",
        "validate",
        "security",
        "docs",
        "change",
        "ship"
      ],
      "description": "Pipeline phase in which the event was emitted."
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "description": "Skill name of the emitting agent (e.g. planifest-codegen-agent)."
    },
    "tool": {
      "type": "string",
      "minLength": 1,
      "description": "Agentic tool name (e.g. claude-code, cursor)."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model identifier (e.g. claude-sonnet-4-6)."
    },
    "mcp_mode": {
      "type": "string",
      "enum": ["none", "workspace", "context", "workspace+context"],
      "description": "Active MCP server configuration during this session."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the event."
    },
    "model_config": {
      "type": "object",
      "description": "Tool-specific model configuration attributes (e.g. effort, thinking). Keys and values are tool-defined.",
      "additionalProperties": true
    },
    "data": {
      "description": "Typed payload. Structure determined by the event field.",
      "anyOf": [
        { "$ref": "#/$defs/PhaseStartData" },
        { "$ref": "#/$defs/PhaseEndData" },
        { "$ref": "#/$defs/SpecGapData" },
        { "$ref": "#/$defs/ValidationFailureData" },
        { "$ref": "#/$defs/DeviationData" },
        { "$ref": "#/$defs/MigrationProposalData" },
        { "$ref": "#/$defs/ContextPressureData" },
        { "$ref": "#/$defs/McpImpactData" },
        { "$ref": "#/$defs/SelfCorrectionData" },
        { "$ref": "#/$defs/PhaseSkipData" },
        { "$ref": "#/$defs/SecurityFindingData" },
        { "$ref": "#/$defs/RetryLimitExceededData" },
        { "$ref": "#/$defs/AdrDecisionData" },
        { "$ref": "#/$defs/DocGapData" },
        { "$ref": "#/$defs/ContextResetData" },
        { "$ref": "#/$defs/ApprovalRequestedData" },
        { "$ref": "#/$defs/FastPathEngagedData" },
        { "$ref": "#/$defs/TestFailureData" },
        { "$ref": "#/$defs/PerformanceRegressionData" },
        { "$ref": "#/$defs/DependencyBlockedData" },
        { "$ref": "#/$defs/SchemaMigrationAppliedData" },
        { "$ref": "#/$defs/LoopIterationData" },
        { "$ref": "#/$defs/PhaseReversalPetitionedData" },
        { "$ref": "#/$defs/PhaseReversalGrantedData" },
        { "$ref": "#/$defs/PhaseReversalDeniedData" }
      ]
    }
  },
  "$defs": {
    "PhaseStartData": {
      "type": "object",
      "required": ["phase_name"],
      "additionalProperties": false,
      "properties": {
        "phase_name": { "type": "string", "minLength": 1 }
      }
    },
    "PhaseEndData": {
      "type": "object",
      "required": ["phase_name", "status", "duration_ms"],
      "additionalProperties": false,
      "properties": {
        "phase_name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "duration_ms": { "type": "number", "minimum": 0 },
        "content_type": { "type": "string" }
      }
    },
    "SpecGapData": {
      "type": "object",
      "required": ["question", "phase_name"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "phase_name": { "type": "string", "minLength": 1 }
      }
    },
    "ValidationFailureData": {
      "type": "object",
      "required": ["failure_type", "phase_name", "attempt_number", "action_id"],
      "additionalProperties": false,
      "properties": {
        "failure_type": { "type": "string", "minLength": 1 },
        "phase_name": { "type": "string", "minLength": 1 },
        "attempt_number": { "type": "integer", "minimum": 1 },
        "action_id": { "type": "string", "minLength": 1 }
      }
    },
    "DeviationData": {
      "type": "object",
      "required": ["component_id", "description", "severity"],
      "additionalProperties": false,
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    },
    "MigrationProposalData": {
      "type": "object",
      "required": ["component_id", "proposal_path", "destructive"],
      "additionalProperties": false,
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "proposal_path": { "type": "string", "minLength": 1 },
        "destructive": { "type": "boolean" }
      }
    },
    "ContextPressureData": {
      "type": "object",
      "required": ["context_fill_pct", "unused_sources", "trigger"],
      "additionalProperties": false,
      "properties": {
        "context_fill_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "unused_sources": { "type": "array", "items": { "type": "string" } },
        "trigger": { "type": "string", "minLength": 1 }
      }
    },
    "McpImpactData": {
      "type": "object",
      "required": ["mcp_mode", "avg_token_delta", "peak_fill_pct"],
      "additionalProperties": false,
      "properties": {
        "mcp_mode": { "type": "string", "enum": ["none", "workspace", "context", "workspace+context"] },
        "avg_token_delta": { "type": "number" },
        "peak_fill_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "SelfCorrectionData": {
      "type": "object",
      "required": ["phase_name", "attempt_number", "action_id", "correction_type"],
      "additionalProperties": false,
      "properties": {
        "phase_name": { "type": "string", "minLength": 1 },
        "attempt_number": { "type": "integer", "minimum": 1 },
        "action_id": { "type": "string", "minLength": 1 },
        "correction_type": { "type": "string", "minLength": 1 }
      }
    },
    "PhaseSkipData": {
      "type": "object",
      "required": ["phase_name", "reason"],
      "additionalProperties": false,
      "properties": {
        "phase_name": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "SecurityFindingData": {
      "type": "object",
      "required": ["component_id", "title", "severity"],
      "additionalProperties": false,
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "cwe": { "type": "string" }
      }
    },
    "RetryLimitExceededData": {
      "type": "object",
      "required": ["phase_name", "action_id", "attempt_count"],
      "additionalProperties": false,
      "properties": {
        "phase_name": { "type": "string", "minLength": 1 },
        "action_id": { "type": "string", "minLength": 1 },
        "attempt_count": { "type": "integer", "minimum": 1 }
      }
    },
    "AdrDecisionData": {
      "type": "object",
      "required": ["adr_id", "title", "chosen_option"],
      "additionalProperties": false,
      "properties": {
        "adr_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "chosen_option": { "type": "string", "minLength": 1 }
      }
    },
    "DocGapData": {
      "type": "object",
      "required": ["component_id", "description"],
      "additionalProperties": false,
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "ContextResetData": {
      "type": "object",
      "required": ["phase_name", "reason"],
      "additionalProperties": false,
      "properties": {
        "phase_name": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "ApprovalRequestedData": {
      "type": "object",
      "required": ["phase_name", "subject", "action_id"],
      "additionalProperties": false,
      "properties": {
        "phase_name": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "action_id": { "type": "string", "minLength": 1 }
      }
    },
    "FastPathEngagedData": {
      "type": "object",
      "required": ["change_type", "reason"],
      "additionalProperties": false,
      "properties": {
        "change_type": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "TestFailureData": {
      "type": "object",
      "required": ["test_name", "phase_name", "attempt_number"],
      "additionalProperties": false,
      "properties": {
        "test_name": { "type": "string", "minLength": 1 },
        "phase_name": { "type": "string", "minLength": 1 },
        "attempt_number": { "type": "integer", "minimum": 1 },
        "error_summary": { "type": "string" }
      }
    },
    "PerformanceRegressionData": {
      "type": "object",
      "required": ["metric", "threshold", "actual", "phase_name"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "threshold": { "type": "number" },
        "actual": { "type": "number" },
        "phase_name": { "type": "string", "minLength": 1 }
      }
    },
    "DependencyBlockedData": {
      "type": "object",
      "required": ["phase_name", "dependency", "reason"],
      "additionalProperties": false,
      "properties": {
        "phase_name": { "type": "string", "minLength": 1 },
        "dependency": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "SchemaMigrationAppliedData": {
      "type": "object",
      "required": ["component_id", "migration_path", "destructive"],
      "additionalProperties": false,
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "migration_path": { "type": "string", "minLength": 1 },
        "destructive": { "type": "boolean" }
      }
    },
    "LoopIterationData": {
      "type": "object",
      "required": ["loop_id", "iteration", "cap", "decision", "toggle_level"],
      "additionalProperties": false,
      "properties": {
        "loop_id": { "type": "string", "enum": ["p0_completeness", "design_critic", "reversal_protocol", "verify_by_execution", "cross_model_review"] },
        "iteration": { "type": "integer", "minimum": 1 },
        "cap": { "type": "integer", "minimum": 1 },
        "decision": { "type": "string", "enum": ["continue", "done", "escalate"] },
        "toggle_level": { "type": "string", "enum": ["report-only", "on"] }
      }
    },
    "PhaseReversalPetitionedData": {
      "type": "object",
      "required": ["report", "filing_phase", "binding_artifact"],
      "additionalProperties": false,
      "properties": {
        "report": { "type": "string", "minLength": 1 },
        "filing_phase": { "type": "string", "minLength": 1 },
        "binding_artifact": { "type": "string", "minLength": 1 }
      }
    },
    "PhaseReversalGrantedData": {
      "type": "object",
      "required": ["report", "classification", "cascade_size", "budget_remaining"],
      "additionalProperties": false,
      "properties": {
        "report": { "type": "string", "minLength": 1 },
        "classification": { "type": "string", "enum": ["additive", "altering"] },
        "cascade_size": { "type": "integer", "minimum": 0 },
        "budget_remaining": { "type": "integer", "minimum": 0 }
      }
    },
    "PhaseReversalDeniedData": {
      "type": "object",
      "required": ["report", "classification", "cascade_size", "budget_remaining"],
      "additionalProperties": false,
      "properties": {
        "report": { "type": "string", "minLength": 1 },
        "classification": { "type": "string", "enum": ["additive", "altering"] },
        "cascade_size": { "type": "integer", "minimum": 0 },
        "budget_remaining": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
