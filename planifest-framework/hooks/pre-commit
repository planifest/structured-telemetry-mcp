#!/bin/bash
# Planifest Advisory Pre-Commit
# Tier 1: Local advisory — warns without blocking atomic commits.

STAGED_FILES=$(git diff --cached --name-only)

if echo "$STAGED_FILES" | grep -q "^src/"; then
    if ! echo "$STAGED_FILES" | grep -qE "^(plan/|docs/|.*component\.yml)"; then
        echo "⚠️  PLANIFEST ADVISORY: no plan/, docs/, or component.yml touched."
        echo "This commit is allowed locally (presence check only, not verified"
        echo "against your change), but your final branch must include updates"
        echo "to plan/, docs/, or the relevant component.yml before pushing."
    fi
fi

exit 0 # Always exits 0 to allow the atomic commit
