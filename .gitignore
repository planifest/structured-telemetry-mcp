# Dependencies
node_modules/

# TypeScript build output and compiled bundles (run build.ps1 / npm run build)
build/
*.bundle.mjs

# Local telemetry data
*.db
*.db-wal
*.db-shm
.planifest/

# Service logs
logs/

# Playwright E2E output (0000016)
test-results/
playwright-report/
blob-report/

# Local-only working files — the *.local-only.* naming convention is now
# enforced, not just implied (0000019 req-012). Matches an infix on both
# sides (foo.local-only.sh), never a bare "local-only.txt" or a directory.
*.local-only.*

# OS cruft
.DS_Store

# Stray backup copies (e.g. accidental duplicate framework dirs)
__*/

# Agent tool config (local to each developer)
.claude/
.cursor/
.agents/
.agent/
.gemini/
.github/skills/
.windsurf/
.clinerules/
CLAUDE.md
AGENTS.md
GEMINI.md
